{
  "name": "work-out-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NAS上のDockerで動かす同期用APIサーバー",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/sync.test.ts test/users.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  }
}
